# Copy to mcp-server/.env (git-ignored) and fill in.
# PocketBase the server talks to. Local test DB: http://127.0.0.1:8090
POCKETBASE_URL=https://dailytodo-pocketbase.ahayder.me
# Preferred: a long-lived impersonation token for your normal DailyTodo user
# (NOT a superuser), so no password is stored. Create one with:
#   pnpm mcp:token            (prod, uses the admin login in .env.local)
# PocketBase rules limit the server to this user's records.
POCKETBASE_USER_TOKEN=
# Fallback when no token is set: your normal DailyTodo login.
POCKETBASE_USER_EMAIL=
POCKETBASE_USER_PASSWORD=
# Long random secret that becomes part of the URL: /mcp/<MCP_SECRET>
# Generate one with: openssl rand -hex 24
MCP_SECRET=
PORT=8787
# The user's time zone, so "today" is their day (IANA name). Default: Asia/Dhaka
USER_TIMEZONE=Asia/Dhaka
